      <column caption='Kaffe Omsætning' datatype='real' name='[coffeeRevenue]' role='measure' type='quantitative' />
      <column caption='Cocktail Salgsandel (%)' datatype='real' name='[cocktailSalesPercent]' role='measure' type='quantitative' />
      <column caption='Kaffe Salgsandel (%)' datatype='real' name='[coffeeSalesPercent]' role='measure' type='quantitative' />
      <column caption='Tidspunkt' datatype='string' name='[generatedAt]' role='dimension' type='nominal' />
    </datasource>
  </datasources>
  <worksheets>
    <!-- Sheet 1: Executive KPI Scorecards -->
    <worksheet name='1. Hovednøgletal'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e293b' fontname='Arial' fontsize='16' bold='true'>Hotel Kong Arthur — Hovednøgletal (Total, Værelser, Bar, ADR)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kong Arthur - Hovednøgletal (REST API)' name='federated.hotel_master_kpis' />
          </datasources>
          <datasource-dependencies datasource='federated.hotel_master_kpis'>
            <column datatype='real' name='[totalRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[roomRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[barRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[adr]' role='measure' type='quantitative' />
            <column-instance column='[totalRevenue]' derivation='Sum' name='[sum:totalRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[roomRevenue]' derivation='Sum' name='[sum:roomRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[barRevenue]' derivation='Sum' name='[sum:barRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[adr]' derivation='Sum' name='[sum:adr:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols>([federated.hotel_master_kpis].[sum:totalRevenue:qk] / [federated.hotel_master_kpis].[sum:roomRevenue:qk] / [federated.hotel_master_kpis].[sum:barRevenue:qk] / [federated.hotel_master_kpis].[sum:adr:qk])</cols>
      </table>
      <simple-id uuid='{698B4CAD-7C81-4731-8580-40A83D4F928E}' />
    </worksheet>

    <!-- Sheet 2: Omsætningsfordeling Værelser vs Bar -->
    <worksheet name='2. Omsætningsfordeling (Værelser vs Bar)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e293b' fontname='Arial' fontsize='14' bold='true'>Omsætningsfordeling: Værelser (45,5%) vs. Lobbybar (54,5%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kong Arthur - Hovednøgletal (REST API)' name='federated.hotel_master_kpis' />
          </datasources>
          <datasource-dependencies datasource='federated.hotel_master_kpis'>
            <column datatype='real' name='[roomRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[barRevenue]' role='measure' type='quantitative' />
            <column-instance column='[roomRevenue]' derivation='Sum' name='[sum:roomRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[barRevenue]' derivation='Sum' name='[sum:barRevenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols>([federated.hotel_master_kpis].[sum:roomRevenue:qk] / [federated.hotel_master_kpis].[sum:barRevenue:qk])</cols>
      </table>
      <simple-id uuid='{A0DD9D50-3A37-4793-AC55-9EED7ABC7F76}' />
    </worksheet>

    <!-- Sheet 3: Cocktails vs Kaffe -->
    <worksheet name='3. Helene Christine (Cocktails vs Kaffe)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e293b' fontname='Arial' fontsize='14' bold='true'>Helene Christine: Salgsfordeling Cocktails (34,5%) vs. Kaffe (65,5%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kong Arthur - Hovednøgletal (REST API)' name='federated.hotel_master_kpis' />
          </datasources>
          <datasource-dependencies datasource='federated.hotel_master_kpis'>
            <column datatype='real' name='[cocktailRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[coffeeRevenue]' role='measure' type='quantitative' />
            <column-instance column='[cocktailRevenue]' derivation='Sum' name='[sum:cocktailRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[coffeeRevenue]' derivation='Sum' name='[sum:coffeeRevenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols>([federated.hotel_master_kpis].[sum:cocktailRevenue:qk] / [federated.hotel_master_kpis].[sum:coffeeRevenue:qk])</cols>
      </table>
      <simple-id uuid='{C673ADA0-9E64-4411-BAC1-EF9580C85A1C}' />
    </worksheet>
  </worksheets>

