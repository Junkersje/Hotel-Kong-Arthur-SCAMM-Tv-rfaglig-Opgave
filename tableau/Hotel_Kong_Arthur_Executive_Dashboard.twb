      <column caption='Værelsesandel (%)' datatype='real' name='[roomRevenuePercentage]' role='measure' type='quantitative' />
      <column caption='Barandel (%)' datatype='real' name='[barRevenuePercentage]' role='measure' type='quantitative' />
      <column caption='Average Daily Rate (ADR)' datatype='real' default-format='C1030kr. #,##0.00;kr. -#,##0.00' name='[adr]' role='measure' type='quantitative' />
      <column caption='Solgte Værelsesnætter' datatype='integer' name='[occupiedRoomNights]' role='measure' type='quantitative' />
      <column caption='Belægningsgrad (%)' datatype='real' name='[estimatedOverallOccupancyPercent]' role='measure' type='quantitative' />
      <column caption='Værelseskapacitet (214)' datatype='integer' name='[totalRoomsCapacity]' role='measure' type='quantitative' />
