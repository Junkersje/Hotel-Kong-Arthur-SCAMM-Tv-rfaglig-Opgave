            <column datatype='real' name='[totalHotelRoomRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[barRevenue]' role='measure' type='quantitative' />
            <column-instance column='[totalHotelRoomRevenue]' derivation='Avg' name='[avg:totalHotelRoomRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[barRevenue]' derivation='Avg' name='[avg:barRevenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
