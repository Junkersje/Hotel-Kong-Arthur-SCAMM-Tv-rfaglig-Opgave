            </style>
          </pane>
        </panes>
        <rows />
        <cols>([federated.hotel_master_kpis].[avg:totalHotelRoomRevenue:qk] / [federated.hotel_master_kpis].[avg:barRevenue:qk])</cols>
      </table>
      <simple-id uuid='{2D97F7A4-F2B1-471E-A6FF-934D7B8C3ECE}' />
    </worksheet>

