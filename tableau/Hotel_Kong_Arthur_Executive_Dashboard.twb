  <worksheets>
    <!-- Sheet 1: Executive KPI Scorecards -->
    <worksheet name='1. Hovednøgletal'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e293b' fontname='Arial' fontsize='16' bold='true'>Hotel Kong Arthur — Hovednøgletal (Total, Værelser, Bar, ADR)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Kong Arthur - Master Analytics (REST API)' name='federated.hotel_master_kpis' />
          </datasources>
          <datasource-dependencies datasource='federated.hotel_master_kpis'>
            <column datatype='real' name='[totalRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[totalHotelRoomRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[barRevenue]' role='measure' type='quantitative' />
            <column datatype='real' name='[overallADR]' role='measure' type='quantitative' />
            <column-instance column='[totalRevenue]' derivation='Avg' name='[avg:totalRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[totalHotelRoomRevenue]' derivation='Avg' name='[avg:totalHotelRoomRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[barRevenue]' derivation='Avg' name='[avg:barRevenue:qk]' pivot='key' type='quantitative' />
            <column-instance column='[overallADR]' derivation='Avg' name='[avg:overallADR:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols>([federated.hotel_master_kpis].[avg:totalRevenue:qk] / [federated.hotel_master_kpis].[avg:totalHotelRoomRevenue:qk] / [federated.hotel_master_kpis].[avg:barRevenue:qk] / [federated.hotel_master_kpis].[avg:overallADR:qk])</cols>
      </table>
      <simple-id uuid='{89AD95DE-AD11-45FD-8FEF-19D8DDB2CEDA}' />
    </worksheet>

    <!-- Sheet 2: Omsætningsfordeling Værelser vs Bar -->
    <worksheet name='2. Omsætningsfordeling (Værelser vs Bar)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#1e293b' fontname='Arial' fontsize='14' bold='true'>Omsætningsfordeling: Værelser (45,5%) vs. Lobbybar (54,5%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
