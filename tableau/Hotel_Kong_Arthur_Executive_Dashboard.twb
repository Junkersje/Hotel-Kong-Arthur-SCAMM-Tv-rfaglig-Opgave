      <column caption='Total Omsætning (DKK)' datatype='real' default-format='C1030kr. #,##0;kr. -#,##0' name='[totalRevenue]' role='measure' type='quantitative' />
      <column caption='Værelsesomsætning (DKK)' datatype='real' default-format='C1030kr. #,##0;kr. -#,##0' name='[roomRevenue]' role='measure' type='quantitative' />
